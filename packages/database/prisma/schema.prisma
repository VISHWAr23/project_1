  @@index([rawMaterialId], map: "idx_inv_tx_rm")
  @@index([transactionType], map: "idx_inv_tx_type")
  @@index([createdAt], map: "idx_inv_tx_date")
  @@map("inventory_transactions")
}

model WorkOrder {
