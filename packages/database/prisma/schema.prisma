  standardWeight Decimal?  @map("standard_weight") @db.Decimal(10, 3)
  targetGsm      Decimal?  @map("target_gsm") @db.Decimal(6, 2)
  minStockLevel  Decimal   @default(0) @map("min_stock_level") @db.Decimal(12, 3)
  
  brand          String?   @db.VarChar(100)
  size           String?   @db.VarChar(100)
  dimensionInches String?  @map("dimension_inches") @db.VarChar(100)
  dimensionCm    String?   @map("dimension_cm") @db.VarChar(100)
  packSize       String?   @map("pack_size") @db.VarChar(100)
