model RawMaterial {
  id                  String   @id @default(uuid()) @db.Uuid
  sku                 String   @unique @db.VarChar(50)
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  hsnCode             String?  @map("hsn_code") @db.VarChar(20)
  minimumStockLevel   Decimal  @map("minimum_stock_level") @db.Decimal(12, 3)
  maximumStockLevel   Decimal  @default(0) @map("maximum_stock_level") @db.Decimal(12, 3)
  reorderQuantity     Decimal  @default(0) @map("reorder_quantity") @db.Decimal(12, 3)
  currentStockBalance Decimal  @default(0) @map("current_stock_balance") @db.Decimal(12, 3)
  reservedStock       Decimal  @default(0) @map("reserved_stock") @db.Decimal(12, 3)
  unitCost            Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  lastPurchaseRate    Decimal  @default(0) @map("last_purchase_rate") @db.Decimal(12, 2)
  avgCost             Decimal  @default(0) @map("avg_cost") @db.Decimal(12, 2)
  gstRate             Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  remarks             String?  @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  
  // Product Variant & Packaging Specifications
  brand               String?  @db.VarChar(100)
  size                String?  @db.VarChar(100) // e.g. "MEDIUM", "LARGE", "EXTRA LARGE", "10cm x 10m"
  dimensionInches     String?  @map("dimension_inches") @db.VarChar(100) // e.g. "28\"-44\""
  dimensionCm         String?  @map("dimension_cm") @db.VarChar(100) // e.g. "70-110 CM"
  packSize            String?  @map("pack_size") @db.VarChar(100) // e.g. "10 PCS/PACK"
  innerPackQty        Int?     @map("inner_pack_qty") // e.g. 10
  packUnit            String?  @map("pack_unit") @db.VarChar(50) // e.g. "Pack", "Pouch", "Box", "Roll"
  boxSize             String?  @map("box_size") @db.VarChar(100) // e.g. "12 PACKS/BOX (120 PCS)"
  masterCartonQty     Int?     @map("master_carton_qty") // e.g. 12
  features            String?  @db.Text // e.g. "Soft Waist Panel, Anti Bacterial, Super Absorbent, Super Leak guard, Wetness indicator"
  variantType         String?  @map("variant_type") @db.VarChar(100) // e.g. "ADULT PULLUPS - PREMIUM"

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  unitId String?        @map("unit_id") @db.Uuid
  unit   UnitOfMeasure? @relation("PrimaryUnitRelation", fields: [unitId], references: [id], onDelete: SetNull)

  secondaryUnitId   String?        @map("secondary_unit_id") @db.Uuid
  secondaryUnit     UnitOfMeasure? @relation("SecondaryUnitRelation", fields: [secondaryUnitId], references: [id], onDelete: SetNull)
  conversionFactor  Decimal?       @map("conversion_factor") @db.Decimal(12, 4) // e.g. 1 Secondary Unit = X Primary Units (e.g. 1 Bale = 170 Kg)
  secondaryUnitName String?        @map("secondary_unit_name") @db.VarChar(50)

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  storageLocationId String?          @map("storage_location_id") @db.Uuid
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)

  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  materialIssues        MaterialIssue[]
  jobWorkChallans       JobWorkChallan[]

  issuedJobWorkOrders   JobWorkOrder[]      @relation("IssuedRawMaterial")
  returnedJobWorkOrders JobWorkOrder[]      @relation("ReturnedFinishedProduct")
  returnedItems         JobWorkReturnItem[] @relation("ReturnedProduct")

  gauzeBatches        GauzeProductionBatch[]
  gauzeRawMaterials   GauzeRawMaterial[]
  gauzePackingEntries GauzePackingEntry[]

  gamjeeFinishedBatches GamjeeProductionBatch[] @relation("GamjeeFinishedProduct")
  gamjeeMaterialInputs  GamjeeMaterialInput[]
  gamjeeFinishedRolls   GamjeeFinishedRoll[]

  customerOrderItems  CustomerOrderItem[]

  @@index([sku], map: "idx_rm_sku")
  @@index([currentStockBalance, minimumStockLevel], map: "idx_rm_low_stock")
  @@map("raw_materials")
}

model InventoryBatch {
  id                 String    @id @default(uuid()) @db.Uuid
  batchNumber        String    @unique @map("batch_number") @db.VarChar(100)
  quantityReceived   Decimal   @map("quantity_received") @db.Decimal(12, 3)
