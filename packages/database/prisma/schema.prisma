// CORE SERIALIZED COTTON ROLL LEDGER
// ==========================================

model CottonRoll {
  id               String      @id @default(uuid()) @db.Uuid
  rollNumber       String      @unique @map("roll_number") @db.VarChar(100)
  barcode          String      @unique @db.VarChar(128)
  batchNumber      String      @map("batch_number") @db.VarChar(100)
  
  parentRollId     String?     @map("parent_roll_id") @db.Uuid
  parentRoll       CottonRoll? @relation("RollGenealogy", fields: [parentRollId], references: [id], onDelete: SetNull)
  childRolls       CottonRoll[] @relation("RollGenealogy")

  materialName     String      @map("material_name") @db.VarChar(150)
  stage            RollStage   @default(GREY_FABRIC_ROLL)
  widthInches      Decimal     @map("width_inches") @db.Decimal(8, 2)
  lengthMeters     Decimal     @map("length_meters") @db.Decimal(10, 2)
  weightKg         Decimal     @map("weight_kg") @db.Decimal(10, 3)
  gsm              Decimal?    @db.Decimal(6, 2)
  
  currentStatus    RollStatus  @default(RAW_RECEIVED) @map("current_status")
  currentLocation  String      @map("current_location") @db.VarChar(150)

  issueDate        DateTime?   @map("issue_date")
  returnDate       DateTime?   @map("return_date")
  
  jobWorkCompanyId String?     @map("job_work_company_id") @db.Uuid
  jobWorkCompany   JobWorkCompany? @relation(fields: [jobWorkCompanyId], references: [id])

  productionBatchId String?    @map("production_batch_id") @db.Uuid
  productionBatch  ProductionBatch? @relation(fields: [productionBatchId], references: [id])

  finishedProductId String?    @map("finished_product_id") @db.Uuid
  finishedProduct  ProductMaster? @relation(fields: [finishedProductId], references: [id])

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  statusHistory    RollStatusHistory[]
  qcInspections    QCInspection[]
  packingItems     PackingBundleItem[]

  @@index([rollNumber], map: "idx_roll_number")
  @@index([batchNumber], map: "idx_roll_batch")
  @@index([currentStatus], map: "idx_roll_status")
  @@map("cotton_rolls")
}

model RollStatusHistory {
  id             String     @id @default(uuid()) @db.Uuid
  rollId         String     @map("roll_id") @db.Uuid
  roll           CottonRoll @relation(fields: [rollId], references: [id], onDelete: Cascade)
  
  fromStatus     RollStatus? @map("from_status")
  toStatus       RollStatus  @map("to_status")
  location       String     @db.VarChar(150)
  remarks        String?    @db.Text
  performedBy    String     @map("performed_by") @db.VarChar(100)
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([rollId], map: "idx_roll_hist_roll")
  @@map("roll_status_history")
}

