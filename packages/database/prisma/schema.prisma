model GauzeProductionBatch {
  id                     String                @id @default(uuid()) @db.Uuid
  batchNumber            String                @unique @map("batch_number") @db.VarChar(100)
  
  productId              String                @map("product_id") @db.Uuid
  product                RawMaterial           @relation(fields: [productId], references: [id])

  gauzeTypeId            String?               @map("gauze_type_id") @db.Uuid
  gauzeType              GauzeType?            @relation(fields: [gauzeTypeId], references: [id], onDelete: SetNull)

  gauzeSizeId            String?               @map("gauze_size_id") @db.Uuid
  gauzeSize              GauzeSize?            @relation(fields: [gauzeSizeId], references: [id], onDelete: SetNull)

  rawMaterialBatchId     String?               @map("raw_material_batch_id") @db.Uuid
  rawMaterialBatch       InventoryBatch?       @relation(fields: [rawMaterialBatchId], references: [id], onDelete: SetNull)

  supplierId             String?               @map("supplier_id") @db.Uuid
  supplier               Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  inputQuantity          Decimal               @map("input_quantity") @db.Decimal(12, 3)
  inputUom               String                @map("input_uom") @db.VarChar(20)

  currentQuantity        Decimal               @default(0) @map("current_quantity") @db.Decimal(12, 3)
  currentUom             String                @map("current_uom") @db.VarChar(20)

  currentStage           String                @default("RAW_MATERIAL") @map("current_stage") @db.VarChar(50)
  status                 GauzeProductionStatus @default(DRAFT)

  productionStartDate    DateTime?             @map("production_start_date") @db.Date
  expectedCompletionDate DateTime?             @map("expected_completion_date") @db.Date
  completionDate         DateTime?             @map("completion_date") @db.Date
  notes                  String?               @db.Text

  createdById            String?               @map("created_by") @db.Uuid
  createdBy              User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  rawMaterials      GauzeRawMaterial[]
  bleachingJobs     GauzeBleachingJob[]
  bleachingReceipts GauzeBleachingReceipt[]
  operations        GauzeProductionOperation[]
  packingEntries    GauzePackingEntry[]
  materialMovements GauzeMaterialMovement[]
  statusHistory     GauzeBatchStatusHistory[]

  @@index([batchNumber], map: "idx_gz_batch_num")
  @@index([status], map: "idx_gz_batch_status")
  @@index([productId], map: "idx_gz_batch_prod")
  @@map("gauze_production_batches")
}

model GauzeRawMaterial {
  id                 String               @id @default(uuid()) @db.Uuid
  productionBatchId  String               @map("production_batch_id") @db.Uuid
  productionBatch    GauzeProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  productId          String               @map("product_id") @db.Uuid
  product            RawMaterial          @relation(fields: [productId], references: [id])

  supplierId         String?              @map("supplier_id") @db.Uuid
  supplier           Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  supplierReference  String?              @map("supplier_reference") @db.VarChar(100)
  rollOrThansNumber  String?              @map("roll_or_thans_number") @db.VarChar(100)

  gauzeTypeId        String?              @map("gauze_type_id") @db.Uuid
  gauzeType          GauzeType?           @relation(fields: [gauzeTypeId], references: [id], onDelete: SetNull)

  gauzeSizeId        String?              @map("gauze_size_id") @db.Uuid
  gauzeSize          GauzeSize?           @relation(fields: [gauzeSizeId], references: [id], onDelete: SetNull)

  quantity           Decimal              @db.Decimal(12, 3)
  uom                String               @db.VarChar(20)
  receivedDate       DateTime?            @map("received_date") @db.Date

  warehouseId        String?              @map("warehouse_id") @db.Uuid
  warehouse          StorageLocation?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  notes              String?              @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([productionBatchId], map: "idx_gz_rm_batch")
  @@map("gauze_raw_materials")
}

model GauzeBleachingJob {
  id                 String               @id @default(uuid()) @db.Uuid
  jobNumber          String               @unique @map("job_number") @db.VarChar(100)

  productionBatchId  String               @map("production_batch_id") @db.Uuid
  productionBatch    GauzeProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  vendorId           String               @map("vendor_id") @db.Uuid
  vendor             JobWorkCompany       @relation(fields: [vendorId], references: [id])

  bleachingTypeId    String               @map("bleaching_type_id") @db.Uuid
  bleachingType      BleachingType        @relation(fields: [bleachingTypeId], references: [id])

  quantitySent       Decimal              @map("quantity_sent") @db.Decimal(12, 3)
  uom                String               @db.VarChar(20)
  sentDate           DateTime             @map("sent_date") @db.Date
  expectedReturnDate DateTime?            @map("expected_return_date") @db.Date

  rate               Decimal?             @db.Decimal(10, 2)
  estimatedCost      Decimal?             @map("estimated_cost") @db.Decimal(12, 2)
  actualCost         Decimal?             @map("actual_cost") @db.Decimal(12, 2)

  status             String               @default("SENT") @db.VarChar(50)
  notes              String?              @db.Text

  createdById        String?              @map("created_by") @db.Uuid
  createdBy          User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  receipts           GauzeBleachingReceipt[]

  @@index([jobNumber], map: "idx_gz_bj_num")
  @@index([productionBatchId], map: "idx_gz_bj_batch")
  @@index([vendorId], map: "idx_gz_bj_vendor")
  @@map("gauze_bleaching_jobs")
}

model GauzeBleachingReceipt {
  id                 String               @id @default(uuid()) @db.Uuid
  receiptNumber      String               @unique @map("receipt_number") @db.VarChar(100)

  bleachingJobId     String               @map("bleaching_job_id") @db.Uuid
  bleachingJob       GauzeBleachingJob    @relation(fields: [bleachingJobId], references: [id], onDelete: Cascade)

  productionBatchId  String               @map("production_batch_id") @db.Uuid
  productionBatch    GauzeProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  quantitySent       Decimal              @map("quantity_sent") @db.Decimal(12, 3)
  quantityReceived   Decimal              @map("quantity_received") @db.Decimal(12, 3)
  wastageQuantity    Decimal              @default(0) @map("wastage_quantity") @db.Decimal(12, 3)
  rejectedQuantity   Decimal              @default(0) @map("rejected_quantity") @db.Decimal(12, 3)
  uom                String               @db.VarChar(20)

  receivedDate       DateTime             @map("received_date") @db.Date
  qualityStatus      String?              @default("PASSED") @map("quality_status") @db.VarChar(50)
  notes              String?              @db.Text

  createdById        String?              @map("created_by") @db.Uuid
  createdBy          User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([receiptNumber], map: "idx_gz_br_num")
  @@index([bleachingJobId], map: "idx_gz_br_job")
  @@index([productionBatchId], map: "idx_gz_br_batch")
  @@map("gauze_bleaching_receipts")
}

model GauzeProductionOperation {
  id                 String               @id @default(uuid()) @db.Uuid
  operationNumber    String               @unique @map("operation_number") @db.VarChar(100)

  productionBatchId  String               @map("production_batch_id") @db.Uuid
  productionBatch    GauzeProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  operationTypeId    String               @map("operation_type_id") @db.Uuid
  operationType      GauzeOperationType   @relation(fields: [operationTypeId], references: [id])

  sequenceNumber     Int                  @map("sequence_number")
  inputQuantity      Decimal              @map("input_quantity") @db.Decimal(12, 3)
  outputQuantity     Decimal              @map("output_quantity") @db.Decimal(12, 3)
  wastageQuantity    Decimal              @default(0) @map("wastage_quantity") @db.Decimal(12, 3)
  rejectedQuantity   Decimal              @default(0) @map("rejected_quantity") @db.Decimal(12, 3)
  uom                String               @db.VarChar(20)

  employeeId         String?              @map("employee_id") @db.Uuid
  employee           Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  machineId          String?              @map("machine_id") @db.VarChar(100)
  operationDate      DateTime             @map("operation_date") @db.Date
  status             String               @default("COMPLETED") @db.VarChar(50)
  notes              String?              @db.Text

  createdById        String?              @map("created_by") @db.Uuid
  createdBy          User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([operationNumber], map: "idx_gz_op_num")
  @@index([productionBatchId], map: "idx_gz_op_batch")
  @@map("gauze_production_operations")
}

model GauzePackingEntry {
  id                       String               @id @default(uuid()) @db.Uuid
  packingNumber            String               @unique @map("packing_number") @db.VarChar(100)

  productionBatchId        String               @map("production_batch_id") @db.Uuid
  productionBatch          GauzeProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

