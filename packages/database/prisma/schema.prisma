generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  PRODUCTION_MANAGER
  WAREHOUSE_INCHARGE
  QC_INSPECTOR
  JOB_WORK_MANAGER
  SALES_EXECUTIVE
  ACCOUNTANT
}

enum RollStatus {
  RAW_RECEIVED              // Received as Cotton Bale / Grey Fabric Roll
  STORED_IN_RM              // Available in Raw Material Warehouse
  ISSUED_TO_JOBWORK         // Dispatched to external Job Worker (Bleaching/Weaving)
  PROCESS_IN_PROGRESS       // Subcontractor processing active
  RETURNED_FROM_JOBWORK     // Received back from Job Worker
  QC_PENDING                // Awaiting Quality Inspection
  QC_APPROVED               // Passed GSM, Absorbency, Whiteness Test
  QC_REJECTED               // Failed Quality Standards
  IN_PRODUCTION             // On Production Floor for Cutting/Slitting/Folding
  CONVERTED                 // Cut into Finished Units (Roller Bandage, Gamjee, etc.)
  PACKED                    // Packed in Pouch / Box / Bundle
  DISPATCHED                // Sold and Dispatched to Customer
  SCRAPPED                  // Written off due to damage/wastage
}

enum RollStage {
  RAW_COTTON_BALE
  GREY_FABRIC_ROLL
  BLEACHED_GAUZE_ROLL
  SLIT_ROLL
  FINISHED_PRODUCT_ROLL
}

enum QCResultStatus {
  PENDING
  PASSED
  REJECTED
  REWORK_REQUIRED
}

enum ProductionWorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKLY_OFF
}

enum TransactionType {
  PURCHASE_RECEIPT
  WORK_ORDER_ISSUE
  JOB_WORK_DISPATCH
  JOB_WORK_RETURN
  ADJUSTMENT_ADD
  ADJUSTMENT_SUBTRACT
  TRANSFER
  MANUAL_CORRECTION
}

enum WorkOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum ChallanStatus {
  DISPATCHED
  PARTIALLY_RETURNED
  COMPLETED
  CLOSED_WITH_DISCREPANCY
}

enum JobWorkStatus {
  CREATED
  MATERIALS_ISSUED
  IN_PROGRESS
  PARTIAL_RETURN
  COMPLETED
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  DRAFT
  APPROVED
  PAID
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

enum AdjustmentType {
  BONUS
  INCENTIVE
  LATE_DEDUCTION
  ADVANCE_DEDUCTION
  LOAN_DEDUCTION
  OTHER_DEDUCTION
  OTHER_ALLOWANCE
}


enum GauzeProductionStatus {
  DRAFT
  RAW_MATERIAL_RECEIVED
  READY_FOR_BLEACHING
  SENT_TO_BLEACHING
  BLEACHING_RECEIVED
  IN_PROCESSING
  READY_FOR_PACKING
  PACKED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum GamjeeProductionStatus {
  DRAFT
  MATERIALS_SELECTED
  PINNING
  FOLDING
  CUTTING
  COTTON_PREPARATION
  READY_FOR_ROLLING
  ROLLING
  COMPLETED
  ON_HOLD
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  employeeId String?   @unique @map("employee_id") @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  inventoryTransactions   InventoryTransaction[]
  requestedMaterialIssues MaterialIssue[]        @relation("RequestedByUsers")
  approvedMaterialIssues  MaterialIssue[]        @relation("ApprovedByUsers")
  jobWorkStatusHistories  JobWorkStatusHistory[]
  jobWorkReturnItems      JobWorkReturnItem[]
  closedJobWorkOrders     JobWorkOrder[]         @relation("ClosedByUsers")
  auditLogs               AuditLog[]
  attendanceLogsCreated   AttendanceLog[]        @relation("AttendanceCreatedByUsers")
  payrollsGenerated       PayrollRun[]           @relation("PayrollGeneratedBy")
  payrollsApproved        PayrollRun[]           @relation("PayrollApprovedBy")
  salaryAdjustmentsCreated SalaryAdjustment[]
  salaryPaymentsRecorded   SalaryPayment[]
  salarySlipsGenerated     SalarySlip[]
  advancesIssued           EmployeeAdvance[]
  advanceRepaymentsRecorded AdvanceRepayment[]

  gauzeProductionBatchesCreated GauzeProductionBatch[]
  gauzeBleachingJobsCreated     GauzeBleachingJob[]
  gauzeBleachingReceiptsCreated GauzeBleachingReceipt[]
  gauzeOperationsCreated        GauzeProductionOperation[]
  gauzePackingEntriesCreated    GauzePackingEntry[]
  gauzeMovementsCreated         GauzeMaterialMovement[]
  gauzeStatusChanges            GauzeBatchStatusHistory[]

  gamjeeProductionBatchesCreated GamjeeProductionBatch[]
  gamjeeMaterialInputsCreated    GamjeeMaterialInput[]
  gamjeeOperationsCreated        GamjeeProductionOperation[]
  gamjeeRollingEntriesCreated    GamjeeRollingEntry[]
  gamjeeMovementsCreated         GamjeeMaterialMovement[]
  gamjeeStatusChanges            GamjeeBatchStatusHistory[]

  customerOrdersCreated       CustomerOrder[]
  customerOrderStatusChanges CustomerOrderStatusHistory[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("designations")
}

model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  employeeCode    String         @unique @map("employee_code") @db.VarChar(50)
  firstName       String         @map("first_name") @db.VarChar(100)
  lastName        String         @map("last_name") @db.VarChar(100)
  phone           String?        @db.VarChar(20)
  alternatePhone  String?        @map("alternate_phone") @db.VarChar(20)
  email           String?        @db.VarChar(255)
  avatarUrl       String?        @map("avatar_url") @db.Text
  gender          String?        @db.VarChar(20)
  dob             DateTime?      @db.Date
  bloodGroup      String?        @map("blood_group") @db.VarChar(10)
  address         String?        @db.Text
  city            String?        @db.VarChar(100)
  state           String?        @db.VarChar(100)
  pinCode         String?        @map("pin_code") @db.VarChar(20)
  emergencyContact String?       @map("emergency_contact") @db.VarChar(100)
  emergencyPhone  String?        @map("emergency_phone") @db.VarChar(20)
  aadhaarNo       String?        @map("aadhaar_no") @db.VarChar(20)
  panNo           String?        @map("pan_no") @db.VarChar(20)
  joiningDate     DateTime       @map("joining_date") @db.Date
  employmentType  String?        @default("Permanent") @map("employment_type") @db.VarChar(50)
  shift           String?        @default("General Day") @db.VarChar(50)
  salaryType      String?        @default("Monthly Salary") @map("salary_type") @db.VarChar(50)
  salaryCycle     String?        @default("MONTHLY") @map("salary_cycle") @db.VarChar(20) // MONTHLY, WEEKLY
  baseWage        Decimal?       @default(0) @map("base_wage") @db.Decimal(12, 2)
  otRatePerHour   Decimal?       @default(0) @map("ot_rate_per_hour") @db.Decimal(10, 2)
  bankName        String?        @map("bank_name") @db.VarChar(100)
  bankAccountNo   String?        @map("bank_account_no") @db.VarChar(50)
  bankIfsc        String?        @map("bank_ifsc") @db.VarChar(20)
  upiId           String?        @map("upi_id") @db.VarChar(100)
  status          EmployeeStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId String?      @map("designation_id") @db.Uuid
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  user              User?
  documents         EmployeeDocument[]
  attendanceLogs    AttendanceLog[]
  salaryStructure   SalaryStructure?
  payrollDetails    PayrollDetail[]
  payrollItems      PayrollItem[]
  salaryAdjustments SalaryAdjustment[]
  salaryPayments    SalaryPayment[]
  salaryHistories   SalaryHistory[]
  salarySlips       SalarySlip[]
  advances          EmployeeAdvance[]
  advanceRepayments AdvanceRepayment[]
  gauzeOperations   GauzeProductionOperation[]
  gamjeeOperations    GamjeeProductionOperation[]
  gamjeeRollingEntries GamjeeRollingEntry[]

  @@index([employeeCode], map: "idx_emp_code")
  @@index([status], map: "idx_emp_status")
  @@index([deletedAt], map: "idx_emp_deleted_at")
  @@map("employees")
}

model EmployeeDocument {
  id           String   @id @default(uuid()) @db.Uuid
  documentType String   @map("document_type") @db.VarChar(100)
  fileName     String   @map("file_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.Text
  storagePath  String?  @map("storage_path") @db.Text
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "idx_emp_doc_emp")
  @@map("employee_documents")
}

model AttendanceLog {
  id            String           @id @default(uuid()) @db.Uuid
  date          DateTime         @db.Date
  checkIn       DateTime?        @map("check_in")
  checkOut      DateTime?        @map("check_out")
  lunchStart    DateTime?        @map("lunch_start")
  lunchEnd      DateTime?        @map("lunch_end")
  status        AttendanceStatus @default(PRESENT)
  workingHours  Decimal          @default(0) @map("working_hours") @db.Decimal(5, 2)
  overtimeHours Decimal          @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  otAmount      Decimal          @default(0) @map("ot_amount") @db.Decimal(10, 2)
  remarks       String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdBy       User?   @relation("AttendanceCreatedByUsers", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date], map: "unique_emp_date")
  @@index([employeeId, date], map: "idx_att_emp_date")
  @@index([date], map: "idx_att_date")
  @@index([status], map: "idx_att_status")
  @@map("attendance_logs")
}

model SalaryStructure {
  id                 String   @id @default(uuid()) @db.Uuid
  baseSalary         Decimal  @map("base_salary") @db.Decimal(12, 2)
  hra                Decimal  @default(0) @db.Decimal(12, 2)
  conveyance         Decimal  @default(0) @db.Decimal(12, 2)
  specialAllowance   Decimal  @default(0) @map("special_allowance") @db.Decimal(12, 2)
  pfDeduction        Decimal  @default(0) @map("pf_deduction") @db.Decimal(12, 2)
  esiDeduction       Decimal  @default(0) @map("esi_deduction") @db.Decimal(12, 2)
  effectiveFrom      DateTime @default(now()) @map("effective_from") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employeeId String   @unique @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model PayrollRun {
  id                 String        @id @default(uuid()) @db.Uuid
  payrollCode        String        @unique @map("payroll_code") @db.VarChar(50)
  month              Int
  year               Int
  periodType         String        @default("MONTHLY") @map("period_type") @db.VarChar(20) // MONTHLY, WEEKLY
  weekNumber         Int?          @map("week_number")
  startDate          DateTime?     @map("start_date") @db.Date
  endDate            DateTime?     @map("end_date") @db.Date
  totalEmployees     Int           @default(0) @map("total_employees")
  totalGross         Decimal       @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions    Decimal       @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalBonus         Decimal       @default(0) @map("total_bonus") @db.Decimal(14, 2)
  totalOvertime      Decimal       @default(0) @map("total_overtime") @db.Decimal(14, 2)
  totalNet           Decimal       @default(0) @map("total_net") @db.Decimal(14, 2)
  status             PayrollStatus @default(DRAFT)
  remarks            String?       @db.Text
  
  generatedAt        DateTime      @default(now()) @map("generated_at")
  generatedByUserId  String?       @map("generated_by_user_id") @db.Uuid
  generatedByUser    User?         @relation("PayrollGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)

  approvedAt         DateTime?     @map("approved_at")
  approvedByUserId   String?       @map("approved_by_user_id") @db.Uuid
  approvedByUser     User?         @relation("PayrollApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  items              PayrollItem[]
  payrollDetails     PayrollDetail[]

  @@unique([month, year], map: "unique_payroll_month_year")
  @@index([status], map: "idx_payroll_status")
  @@map("payroll_runs")
}

model PayrollDetail {
  id                 String   @id @default(uuid()) @db.Uuid
  totalPresentDays   Decimal  @map("total_present_days") @db.Decimal(5, 2)
  grossEarnings      Decimal  @map("gross_earnings") @db.Decimal(12, 2)
  totalDeductions    Decimal  @map("total_deductions") @db.Decimal(12, 2)
  netSalary          Decimal  @map("net_salary") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  payrollRunId String     @map("payroll_run_id") @db.Uuid
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "idx_payroll_detail_emp")
  @@map("payroll_details")
}

model PayrollItem {
  id                 String        @id @default(uuid()) @db.Uuid
  payrollRunId       String        @map("payroll_run_id") @db.Uuid
  payrollRun         PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId         String        @map("employee_id") @db.Uuid
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  salaryType         String        @default("Monthly Salary") @map("salary_type") @db.VarChar(50)
  periodType         String        @default("MONTHLY") @map("period_type") @db.VarChar(20) // MONTHLY, WEEKLY
  baseWage           Decimal       @default(0) @map("base_wage") @db.Decimal(12, 2)
  
  workingDaysInMonth Int           @default(26) @map("working_days_in_month")
  presentDays        Decimal       @default(0) @map("present_days") @db.Decimal(5, 2)
  absentDays         Decimal       @default(0) @map("absent_days") @db.Decimal(5, 2)
  halfDays           Decimal       @default(0) @map("half_days") @db.Decimal(5, 2)
  leaveDays          Decimal       @default(0) @map("leave_days") @db.Decimal(5, 2)
  holidayCount       Decimal       @default(0) @map("holiday_count") @db.Decimal(5, 2)
  weeklyOffCount     Decimal       @default(0) @map("weekly_off_count") @db.Decimal(5, 2)
  payableDays        Decimal       @default(0) @map("payable_days") @db.Decimal(5, 2)

  basicSalary        Decimal       @default(0) @map("basic_salary") @db.Decimal(12, 2)
  
  overtimeHours      Decimal       @default(0) @map("overtime_hours") @db.Decimal(6, 2)
  overtimeRate       Decimal       @default(0) @map("overtime_rate") @db.Decimal(10, 2)
  overtimeSalary     Decimal       @default(0) @map("overtime_salary") @db.Decimal(12, 2)

  grossSalary        Decimal       @default(0) @map("gross_salary") @db.Decimal(12, 2)

  bonusAmount        Decimal       @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  incentiveAmount    Decimal       @default(0) @map("incentive_amount") @db.Decimal(12, 2)

  lateDeduction      Decimal       @default(0) @map("late_deduction") @db.Decimal(12, 2)
  advanceDeduction   Decimal       @default(0) @map("advance_deduction") @db.Decimal(12, 2)
  loanDeduction      Decimal       @default(0) @map("loan_deduction") @db.Decimal(12, 2)
  pfDeduction        Decimal       @default(0) @map("pf_deduction") @db.Decimal(12, 2)
  esiDeduction       Decimal       @default(0) @map("esi_deduction") @db.Decimal(12, 2)
  professionalTax    Decimal       @default(0) @map("professional_tax") @db.Decimal(12, 2)
  otherDeductions    Decimal       @default(0) @map("other_deductions") @db.Decimal(12, 2)
  totalDeductions    Decimal       @default(0) @map("total_deductions") @db.Decimal(12, 2)

  netSalary          Decimal       @default(0) @map("net_salary") @db.Decimal(12, 2)
  status             PayrollStatus @default(DRAFT)

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  adjustments        SalaryAdjustment[]
  payments           SalaryPayment[]
  salarySlip         SalarySlip?

  @@index([payrollRunId], map: "idx_payroll_item_run")
  @@index([employeeId], map: "idx_payroll_item_emp")
  @@index([status], map: "idx_payroll_item_status")
  @@map("payroll_items")
}

model SalaryAdjustment {
  id                 String         @id @default(uuid()) @db.Uuid
  employeeId         String         @map("employee_id") @db.Uuid
  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  payrollItemId      String?        @map("payroll_item_id") @db.Uuid
  payrollItem        PayrollItem?   @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  month              Int
  year               Int
  type               AdjustmentType
  amount             Decimal        @db.Decimal(12, 2)
  reason             String?        @db.Text
  
  createdByUserId    String?        @map("created_by_user_id") @db.Uuid
  createdBy          User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([employeeId, month, year], map: "idx_adj_emp_period")
  @@map("salary_adjustments")
}

model SalaryPayment {
  id                 String        @id @default(uuid()) @db.Uuid
  payrollItemId      String?       @map("payroll_item_id") @db.Uuid
  payrollItem        PayrollItem?  @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  employeeId         String        @map("employee_id") @db.Uuid
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  paymentType        String        @default("NORMAL_SALARY") @map("payment_type") @db.VarChar(50) // NORMAL_SALARY, OVERTIME_SALARY, ADVANCE_DISBURSEMENT, ADVANCE_REPAYMENT, FULL_SETTLEMENT
  amount             Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  transactionRef     String?       @map("transaction_ref") @db.VarChar(100)
  paymentDate        DateTime      @default(now()) @map("payment_date")
  remarks            String?       @db.Text

  paidByUserId       String?       @map("paid_by_user_id") @db.Uuid
  paidByUser         User?         @relation(fields: [paidByUserId], references: [id], onDelete: SetNull)

  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([payrollItemId], map: "idx_payment_payroll_item")
  @@index([employeeId], map: "idx_payment_employee")
  @@map("salary_payments")
}

model EmployeeAdvance {
  id              String             @id @default(uuid()) @db.Uuid
  employeeId      String             @map("employee_id") @db.Uuid
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  amount          Decimal            @db.Decimal(12, 2)
  repaidAmount    Decimal            @default(0) @map("repaid_amount") @db.Decimal(12, 2)
  balanceAmount   Decimal            @map("balance_amount") @db.Decimal(12, 2)
  weeklyDeduction Decimal            @default(0) @map("weekly_deduction") @db.Decimal(12, 2)
  reason          String?            @db.Text
  status          String             @default("ACTIVE") @db.VarChar(50) // ACTIVE, FULLY_REPAID, CANCELLED
  issueDate       DateTime           @default(now()) @map("issue_date") @db.Date
  
  repayments      AdvanceRepayment[]
  
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  createdByUser   User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([employeeId], map: "idx_emp_advance_emp")
  @@map("employee_advances")
}

model AdvanceRepayment {
  id               String           @id @default(uuid()) @db.Uuid
  advanceId        String           @map("advance_id") @db.Uuid
  advance          EmployeeAdvance  @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  
  employeeId       String           @map("employee_id") @db.Uuid
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  amount           Decimal          @db.Decimal(12, 2)
  paymentMethod    PaymentMethod    @default(CASH) @map("payment_method")
  repaymentDate    DateTime         @default(now()) @map("repayment_date")
  payrollItemId    String?          @map("payroll_item_id") @db.Uuid
  notes            String?          @db.Text
  
  recordedByUserId String?          @map("recorded_by_user_id") @db.Uuid
  recordedByUser   User?            @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([advanceId], map: "idx_adv_repay_adv")
  @@index([employeeId], map: "idx_adv_repay_emp")
  @@map("advance_repayments")
}

model SalaryHistory {
  id                 String        @id @default(uuid()) @db.Uuid
  employeeId         String        @map("employee_id") @db.Uuid
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  month              Int
  year               Int
  salaryType         String        @db.VarChar(50)
  grossSalary        Decimal       @db.Decimal(12, 2)
  totalDeductions    Decimal       @db.Decimal(12, 2)
  netSalary          Decimal       @db.Decimal(12, 2)
