# Monorepo Shared Environment Configuration
PORT=4000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=ims_super_secret_jwt_key_2026

# Database Connection (Replace with your PostgreSQL / Supabase connection details)
# For local PostgreSQL, DATABASE_URL and DIRECT_URL can be identical.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ims_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ims_db?schema=public"
